// ============================================
// TICKET SERVICE - schema.prisma
// Base: repo original + US09, US17, US18
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("TICKET_DATABASE_URL")
}

model Compra {
  id          Int           @id @default(autoincrement())
  usuarioId   Int           @map("usuario_id")
  frecuenciaId Int          @map("frecuencia_id")
  fechaViaje  DateTime      @map("fecha_viaje") @db.Date
  cantidad    Int           @default(1)
  total       Decimal       @db.Decimal(10, 2)
  canal       CanalVenta
  estado      EstadoCompra  @default(PENDIENTE)
  creadoEn    DateTime      @default(now()) @map("creado_en")

  boletos Boleto[]
  pago    PagoPasajero?

  @@map("compras")
}

model Boleto {
  id              Int          @id @default(autoincrement())
  compraId        Int          @map("compra_id")
  uuidQr          String       @unique @default(uuid()) @map("uuid_qr")
  cedulaPasajero  String       @map("cedula_pasajero")
  nombrePasajero  String       @map("nombre_pasajero")
  asientoNumero   Int?         @map("asiento_numero")
  asientoTipo     String?      @map("asiento_tipo")
  rutaNombre      String?      @map("ruta_nombre")
  tipoTarifa      TipoTarifa   @default(NORMAL) @map("tipo_tarifa")
  estado          EstadoBoleto @default(PENDIENTE)
  expiraEn        DateTime     @map("expira_en")
  creadoEn        DateTime     @default(now()) @map("creado_en")

  compra            Compra             @relation(fields: [compraId], references: [id])
  escaneo           Escaneo?
  boletoParada      BoletoParada?
  registroDescuento RegistroDescuento?

  @@map("boletos")
}

model PagoPasajero {
  id       Int          @id @default(autoincrement())
  compraId Int          @unique @map("compra_id")
  monto    Decimal      @db.Decimal(10, 2)
  metodo   MetodoPago
  estado   EstadoPago   @default(PENDIENTE)
  pagadoEn DateTime?    @map("pagado_en")

  compra          Compra            @relation(fields: [compraId], references: [id])
  pagoTarjeta     PagoTarjeta?
  pagoTransferencia PagoTransferencia?
  pagoEfectivo    PagoEfectivo?

  @@map("pagos_pasajero")
}

model PagoTarjeta {
  id                 Int    @id @default(autoincrement())
  pagoId             Int    @unique @map("pago_id")
  ultimos4           String @map("ultimos_4")
  marca              String
  referenciaPasarela String @map("referencia_pasarela")

  pago PagoPasajero @relation(fields: [pagoId], references: [id])

  @@map("pagos_tarjeta")
}

model PagoTransferencia {
  id             Int                  @id @default(autoincrement())
  pagoId         Int                  @unique @map("pago_id")
  banco          String
  referencia     String
  comprobanteUrl String?              @map("comprobante_url")
  estado         EstadoTransferencia  @default(PENDIENTE)

  pago       PagoPasajero @relation(fields: [pagoId], references: [id])
  aprobacion Aprobacion?

  @@map("pagos_transferencia")
}

model Aprobacion {
  id                  Int              @id @default(autoincrement())
  pagoTransferenciaId Int              @unique @map("pago_transferencia_id")
  oficinistaId        Int              @map("oficinista_id")
  estado              EstadoAprobacion
  observacion         String?
  revisadoEn          DateTime         @default(now()) @map("revisado_en")

  pagoTransferencia PagoTransferencia @relation(fields: [pagoTransferenciaId], references: [id])

  @@map("aprobaciones")
}

model PagoEfectivo {
  id            Int        @id @default(autoincrement())
  pagoId        Int        @unique @map("pago_id")
  vendedorId    Int        @map("vendedor_id")
  montoRecibido Decimal    @map("monto_recibido") @db.Decimal(10, 2)
  cambio        Decimal    @db.Decimal(10, 2)
  canalVenta    CanalEfectivo @map("canal_venta")
  turnoId       Int?       @map("turno_id")

  pago PagoPasajero @relation(fields: [pagoId], references: [id])

  @@map("pagos_efectivo")
}

model Escaneo {
  id          Int              @id @default(autoincrement())
  boletoId    Int              @unique @map("boleto_id")
  oficialId   Int              @map("oficial_id")
  busId       Int              @map("bus_id")
  turnoId     Int              @map("turno_id")
  resultado   ResultadoEscaneo
  escaneadoEn DateTime         @default(now()) @map("escaneado_en")

  boleto Boleto @relation(fields: [boletoId], references: [id])

  @@map("escaneos")
}

model BoletoParada {
  id               Int               @id @default(autoincrement())
  boletoId         Int               @unique @map("boleto_id")
  paradaOrigenId   Int               @map("parada_origen_id")
  paradaDestinoId  Int               @map("parada_destino_id")
  estado           EstadoBoletoParada @default(PENDIENTE)

  boleto         Boleto          @relation(fields: [boletoId], references: [id])
  alertasParada  AlertaParada[]

  @@map("boleto_paradas")
}

// NUEVO (US09): Control anti-fraude
model RegistroDescuento {
  id         Int        @id @default(autoincrement())
  cedula     String
  boletoId   Int        @unique @map("boleto_id")
  tipoTarifa TipoTarifa @map("tipo_tarifa")
  aplicadoEn DateTime   @default(now()) @map("aplicado_en")

  boleto Boleto @relation(fields: [boletoId], references: [id])

  @@index([cedula, aplicadoEn])
  @@map("registro_descuentos")
}

// NUEVO (US17/US18): Reemplaza AlertaGps del original
model AlertaParada {
  id              Int              @id @default(autoincrement())
  turnoId         Int              @map("turno_id")
  paradaId        Int              @map("parada_id")
  boletoParadaId  Int?             @map("boleto_parada_id")
  tipo            TipoAlerta
  estado          EstadoAlertaParada @default(PENDIENTE)
  creadoEn        DateTime         @default(now()) @map("creado_en")

  boletoParada BoletoParada? @relation(fields: [boletoParadaId], references: [id])

  @@map("alertas_parada")
}

// ENUMS

enum CanalVenta {
  APP
  WEB
  OFICIAL
  OFICINISTA
}

enum TipoTarifa {
  NORMAL
  TERCERA_EDAD
  DISCAPACIDAD
  MENOR
}

enum EstadoCompra {
  PENDIENTE
  CONFIRMADA
  ANULADA
}

enum EstadoBoleto {
  PENDIENTE
  VIGENTE
  UTILIZADO
  EXPIRADO
  ANULADO
}

enum MetodoPago {
  TARJETA
  TRANSFERENCIA
  EFECTIVO
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum EstadoTransferencia {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum EstadoAprobacion {
  APROBADO
  RECHAZADO
}

enum CanalEfectivo {
  BUS
  OFICINA
}

enum ResultadoEscaneo {
  APROBADO
  RECHAZADO
}

enum EstadoBoletoParada {
  PENDIENTE
  ALERTADO
  BAJADO
}

enum TipoAlerta {
  CHOFER
  PASAJERO
}

enum EstadoAlertaParada {
  PENDIENTE
  ENVIADA
  LEIDA
}
