PORT=3003
TICKET_DATABASE_URL="postgresql://admin:rootpassword@localhost:5433/ticket_db?schema=public"
BUS_API_URL="http://localhost:3002"
AUTH_API_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3010"
APP_PUBLIC_URL="http://localhost:3010"

# US11: upload de comprobantes de transferencia
UPLOAD_DIR="./uploads/comprobantes"
MAX_UPLOAD_BYTES=5242880

# Stripe (sandbox) — US10
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# US23: SMTP para emails transaccionales.
# Si SMTP_HOST falta, el sistema cae a modo stub (console.log) y NO rompe los flujos.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TicketBus <no-reply@ticketbus.local>"
SMTP_SECURE=false
